    {
      "name": "Create a test OTP",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Idempotency-Key",
            "value": "{{$guid}}"
          },
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "url": "{{base_url}}/otps",
        "description": "Local test mode only; not deployed by this branch. Default six digits; 5–7 accepted. Five attempts; 1–10 minute expiry. sandbox.code exists only on creation.",
        "body": {
          "mode": "raw",
          "raw": "{\n  \"customer\": {\n    \"name\": \"Test Customer\",\n    \"first_name\": \"Test\",\n    \"last_name\": \"Customer\",\n    \"email\": \"test@example.com\",\n    \"phone\": \"2348000000000\"\n  },\n  \"medium\": [\n    \"sms\"\n  ]\n}",
          "options": {
            "raw": {
              "language": "json"
            }
          }
        }
      },
      "x-operation-id": "createOtp",
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "if (pm.response.code < 300) pm.collectionVariables.set('otp_id', pm.response.json().id);"
            ]
          }
        }
      ]
    },
